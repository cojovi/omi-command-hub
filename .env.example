APP_NAME=omi-command-hub
APP_ENV=development
APP_BASE_URL=https://omi.cojovi.com

DATABASE_URL=postgresql+psycopg://omi_user:CHANGE_ME@postgres:5432/omi_command_hub
POSTGRES_PASSWORD=CHANGE_ME
REDIS_URL=redis://redis:6379/0

OMI_WEBHOOK_SECRET=CHANGE_ME_LONG_RANDOM_STRING
OMI_SIGNING_SECRET=
OMI_APP_ID=
OMI_APP_SECRET=
OMI_API_KEY=
OMI_NOTIFY=1

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
DEFAULT_TZ=America/Chicago

NOTION_TOKEN=
NOTION_DATABASE_ID=
NOTION_PROP_NAME=Name
NOTION_PROP_DUE=Due
NOTION_PROP_PRIORITY=Priority
NOTION_PROP_TAGS=Tags
NOTION_PROP_PEOPLE=People
NOTION_PROP_LOCATION=Location
NOTION_PROP_NOTES=Notes
NOTION_PROP_FINGERPRINT=Fingerprint

GOOGLE_CHAT_WEBHOOK_URL=

HOME_ASSISTANT_BASE_URL=
HOME_ASSISTANT_TOKEN=

LOG_LEVEL=INFO
LEGACY_OMI_ROUTES=0

ADMIN_USERNAME=admin
ADMIN_PASSWORD=

CORS_ALLOWED_ORIGINS=

# Local-only bind for debugging (public URL uses nginx-proxy, not this port)
NGINX_HTTP_PORT=8080
API_PORT=8000
OMI_VIRTUAL_HOST=omi.cojovi.com
LETSENCRYPT_EMAIL=you@example.com
